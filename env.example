# --- money path (required) ---
DATABASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
APP_URL=
PUBLIC_URL=   # public origin (e.g. quick tunnel) for URLs a cloud browser must reach; blank = APP_URL

# --- capability flags: 1 = on. Off must leave the product fully usable (that is the acceptance test) ---
CAP_STUDIO=1
CAP_CHANNEL3=1
CAP_KERNEL=1
CAP_BRYNTUM=1
CAP_ZAPIER=1
CAP_RENDER=0
CAP_ELASTIC=0
CAP_ASTROPODS=0
CAP_GROQ=
CAP_OPENROUTER=
CAP_NVIDIA=
CAP_TOKENROUTER=
CAP_BLUESMINDS=
CAP_TAVILY=
CAP_EXA=

# --- vendors (a missing key = that capability is off) ---
NEXT_PUBLIC_AG_STUDIO_KEY=
STUDIO_LLM_BASE_URL=            # any OpenAI-compatible chat-completions base, e.g. https://api.openai.com/v1
STUDIO_LLM_API_KEY=
NEXT_PUBLIC_STUDIO_AI=0         # 1 shows the Studio chat panel (needs the two lines above)
NEXT_PUBLIC_STUDIO_MODEL=claude-haiku-4-5
CHANNEL3_API_KEY=
KERNEL_API_KEY=
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ASTROPODS_AGENT_URL=            # launch URL of the hosted concierge agent (a link only)
ZAPIER_MCP_TOKEN=
ZAPIER_MCP_URL=                 # optional: a full per-server MCP URL instead of the token
ZAPIER_NUDGE_TOOL=gmail_send_email
RENDER_API_KEY=
RENDER_WORKFLOW_TASK=standing-promise-cycles/sweep

# --- optional ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=               # NVIDIA NIM (integrate.api.nvidia.com/v1)
TOKENROUTER_API_KEY=          # TokenRouter gateway (api.tokenrouter.com/v1)
BLUESMINDS_API_KEY=           # Bluesminds gateway (api.bluesminds.com/v1)
TAVILY_API_KEY=
EXA_API_KEY=
PAYPAL_SANDBOX_BUYER_EMAIL=   # scripted sandbox approval on the live browser; never sent to a model
PAYPAL_SANDBOX_BUYER_PASSWORD=
